{
  "profile": "product-admin",
  "sourceRoots": ["src/renderer"],
  "locale": "zh-CN",
  "canonicalMap": "UX-CONTRACT.md",
  "requiredCapabilities": ["Form", "Select/Listbox", "Scrollbar", "Toast", "CRUD", "Table Selection"],
  "ownership": { "Select/Listbox": "native" },
  "requiredCommands": ["unit", "integration", "typecheck", "lint", "build", "ui"],
  "commands": {
    "unit": "npm run test:unit",
    "integration": "npm run test:integration",
    "typecheck": "npm run typecheck",
    "lint": "npm run lint",
    "build": "npm run build",
    "ui": "node scripts/verify-workbench-ui.mjs"
  },
  "evidence": {
    "crudFullFlow": "tests/integration/workbench-service.test.ts",
    "failurePaths": "tests/unit/workbench-security.test.ts"
  }
}
